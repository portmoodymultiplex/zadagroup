# Netlify redirects for zadagroup.ca
# Maps old WordPress URLs (still in Google's index) to live pages.
# Drop this file in the site root (same level as index.html). One rule per line.
# Netlify handles trailing-slash variants automatically.

# --- Blog moved to /journal (Nov 2026). Keeps every old /blog link and Google result working. ---
/blog          /journal/          301!
/blog/*        /journal/:splat    301!

# --- Port Moody upsize blog post (Facebook ad links to /portmoodymarket) ---
/portmoodymarket         /journal/port-moody-upsize-market  301!
/portmoodymarket.html    /journal/port-moody-upsize-market  301!
/port-moody-market       /journal/port-moody-upsize-market  301!
/port-moody-market.html  /journal/port-moody-upsize-market  301!

# --- 512 Garrett listing (dashed variants) ---
/512-garrett         /512garrett  301!
/512-garrett-street  /512garrett  301!

# --- Port Moody (old hub children -> new hub page) ---
/port-moody-real-estate/port-moody-houses-for-sale/*     /port-moody-real-estate  301!
/port-moody-real-estate/port-moody-townhouses-for-sale/* /port-moody-real-estate  301!
/port-moody-real-estate/port-moody-condos-for-sale/*     /port-moody-real-estate  301!
/port-moody-real-estate/*                                /port-moody-real-estate  301!

# --- Coquitlam (redirect to listings until a Coquitlam hub page exists,
#     then change these to /coquitlam-real-estate) ---
/coquitlam-real-estate/*        /sales  301!
/port-coquitlam-real-estate/*   /sales  301!

# --- Old listing / search pages ---
/featured/*             /sales  301!
/featured-past-sales/*  /sales  301!
/property-search/*      /sales  301!
/listings/*             /sales  301!
/condos/*               /sales  301!
/townhouses/*           /sales  301!
/detached-homes/*       /sales  301!
/acreages/*             /sales  301!

# --- Old blog posts and WordPress taxonomy pages ---
/real-estate/*  /journal/  301!
/category/*     /journal/  301!
/tag/*          /journal/  301!
/author/*       /journal/  301!

# --- WordPress leftovers ---
/wp-content/*  /  301!
/wp-json/*     /  301!
/feed/*        /journal/  301!
